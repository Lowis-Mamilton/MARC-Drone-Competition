config_version=5

[application]
config/name="MARC 火線救援模擬器"
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
ProfileStore="*res://src/data/profile_store.gd"
ControlServer="*res://src/network/control_server.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/min_width=1100
window/size/min_height=720
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/default_gravity=9.80665

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025,0.04,0.07,1)
